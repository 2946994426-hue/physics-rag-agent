# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Embedding 模型配置
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# FAISS 配置
FAISS_INDEX_PATH=./faiss_index
TOP_K=5

# 文本切片配置
CHUNK_SIZE=1024
CHUNK_OVERLAP=200

# 数据目录
DATA_DIR=./data
